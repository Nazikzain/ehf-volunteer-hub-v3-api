# EHF Volunteer Hub V3 API — example configuration.
# Copy to .env (never committed) and fill in. On servers, .env lives outside the web root
# (the project root, next to public/) and is readable only by the PHP user.
# No real values belong in this file.

# local | testing | staging | production. Unset means production (strictest rules).
APP_ENV=local

# Empty when the API is served at the root of its host; otherwise e.g. /backend.
APP_BASE_PATH=

# Exact frontend origins allowed to call the API with credentials, comma-separated.
# No wildcards; https only in staging and production. The real domains depend on decision A3.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Strict-Transport-Security. Defaults to on in staging/production (cannot be turned off there).
HSTS_ENABLED=false

# Largest accepted JSON request body, in bytes (default 1048576).
MAX_JSON_BODY_BYTES=1048576

# Application log (JSON lines). Default: storage/logs/app.log. Must be outside the web root.
LOG_PATH=
LOG_LEVEL=info

# Runtime database user (Phase 3 onwards; Phase 2 opens no connection).
# Leave all four empty until the new V3 database and its user exist. Never reuse old credentials.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
