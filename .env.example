# EHF Volunteer Hub V3 API — example configuration.
# Copy to .env (never committed) and fill in. On servers, .env lives outside the web root
# (the project root, next to public/) and is readable only by the PHP user.
# No real values belong in this file.

# local | testing | staging | production. Unset means production (strictest rules).
APP_ENV=local

# Empty when the API is served at the root of its host; otherwise e.g. /backend.
APP_BASE_PATH=

# Exact frontend origins allowed to call the API with credentials, comma-separated.
# No wildcards; https only in staging and production. The real domains depend on decision A3.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Strict-Transport-Security. Defaults to on in staging/production (cannot be turned off there).
HSTS_ENABLED=false

# Largest accepted JSON request body, in bytes (default 1048576).
MAX_JSON_BODY_BYTES=1048576

# Application log (JSON lines). Default: storage/logs/app.log. Must be outside the web root.
LOG_PATH=
LOG_LEVEL=info

# Runtime database user (Phase 3 onwards; Phase 2 opens no connection).
# Leave all four empty until the new V3 database and its user exist. Never reuse old credentials.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Sign-in (Phase 4). Every value depends on a decision that is still pending, so none has a
# default and this file sets none (docs/phase-4-decisions.md):
#   A3 SameSite (Lax | Strict | None) · A4 session timeouts · A6 password length · A7 rate limits.
# Leave ALL of them empty and sign-in stays off (503 on the sign-in endpoints). Setting only some
# of them stops the application at start-up.
AUTH_SESSION_SAMESITE=
AUTH_SESSION_IDLE_MINUTES=
AUTH_SESSION_ABSOLUTE_MINUTES=
AUTH_PASSWORD_MIN_LENGTH=
AUTH_PASSWORD_MAX_LENGTH=
AUTH_RATE_LOGIN_ACCOUNT_MAX=
AUTH_RATE_LOGIN_IP_MAX=
AUTH_RATE_LOGIN_WINDOW_MINUTES=
AUTH_RATE_TOKEN_IP_MAX=
AUTH_RATE_TOKEN_WINDOW_MINUTES=

# Migration user (command line only; Phase 3). Separate from the runtime user (API §15.2): it may
# create and alter tables. Fill in only where migrations are run; see docs/database.md.
MIGRATION_DB_HOST=
MIGRATION_DB_PORT=3306
MIGRATION_DB_NAME=
MIGRATION_DB_USER=
MIGRATION_DB_PASSWORD=
